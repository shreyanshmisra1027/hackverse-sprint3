# Browser-visible build setting. This must be the public Render WebSocket URL.
VITE_SIGNALING_URL=wss://p2p-signaling-n43r.onrender.com
# Do not add VITE_API_URL in Vercel: production always uses same-origin /api.
# It is optional for a separate local API host only:
# VITE_API_URL=http://localhost:3000
# Server-only Vercel settings (set these in the Vercel dashboard; never expose them with VITE_):
# DATABASE_URL=postgresql://...-pooler.../neondb?sslmode=require
# MESSAGE_ENCRYPTION_KEY=<base64 encoded random 32-byte key>
