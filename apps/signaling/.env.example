# Server Configuration
PORT=8080

# Allowed origins for CORS (comma-separated list)
# Use * for all origins (development only)
# In production, set your specific frontend domain(s)
ALLOWED_ORIGINS=https://your-frontend.vercel.app,https://your-frontend.pages.dev

# Optional: TURN server configuration (for NAT traversal fallback)
# These are placeholders - you'll need to set up your own TURN server
TURN_SERVER=
TURN_USERNAME=
TURN_CREDENTIAL=

# Optional: Rate limiting (already has sensible defaults)
# MAX_MESSAGES_PER_WINDOW=30
# RATE_LIMIT_WINDOW_MS=10000
