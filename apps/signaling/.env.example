# Render signaling service configuration
# The signaling service has no database, login, email, or OTP configuration.

# Exact browser origins allowed to open WebSocket connections. In production,
# use the Vercel deployment URL and any custom domain, comma separated.
ALLOWED_ORIGINS=http://localhost:5173,https://hackverse-sprint3.vercel.app

# Render supplies PORT in production. These are optional local safeguards.
# PORT=10000
# MAX_CONNECTIONS=500
# MAX_PAYLOAD_BYTES=70000
# MAX_MESSAGES_PER_WINDOW=40
# RATE_WINDOW_MS=10000
