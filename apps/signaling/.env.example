# Neon pooled URL for application traffic. Never commit the real value.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require

# Resend API key. Replace re_xxxxxxxxx with the key created in Resend's API Keys page.
RESEND_API_KEY=re_xxxxxxxxx
# Must use a verified Resend domain in production. onboarding@resend.dev is for Resend's test flow only.
MAIL_FROM=ineVITable <noreply@auth.inevitable.com>

# Comma-separated frontend origins permitted to call the API and open WebSockets.
ALLOWED_ORIGINS=http://localhost:5173
